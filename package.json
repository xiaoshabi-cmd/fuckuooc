{
  "name": "fuckuooc",
  "version": "1.0.0",
  "description": "UOOC 自动刷课工具 - 支持可视化界面和开机自启动",
  "main": "electron/main.js",
  "license": "MIT",
  "scripts": {
    "start": "node start.js",
    "gui": "electron .",
    "dev": "electron . --dev",
    "shortcut": "powershell -ExecutionPolicy Bypass -File create-shortcut.ps1",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.fuckuooc.app",
    "productName": "UOOC刷课",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "utils/**/*",
      "start.js",
      "config.txt",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "electron/renderer/icon.png"
    }
  },
  "dependencies": {
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}
